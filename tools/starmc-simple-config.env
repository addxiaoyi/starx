# StarMC 简约配置（单一配置源）
# 修改后运行: npm run config:doctor:simple
# 本地覆盖（不提交）: tools/starmc-simple-config.local.env

STARMC_PROFILE=local
STARMC_SITE_NAME=StarMC
STARMC_HOST=127.0.0.1
STARMC_FRONTEND_PORT=5173
STARMC_BACKEND_PORT=8787
STARMC_PLUGIN_CALLBACK_PORT=8788
STARMC_VLA_HTTP_PORT=8090
STARMC_VELOCITY_MC_PORT=25579
STARMC_SUPERTOKENS_PORT=3567

# 生产官网（local 可留空，由端口推导）
# STARMC_PUBLIC_SITE_URL=https://star-web.top
# STARMC_PUBLIC_API_URL=https://star-web.top
# STARMC_TRUST_PROXY=true

# 密钥：local 可写 auto 自动生成；production 必须填写固定值
STARMC_VLA_API_KEY=auto
STARMC_VLA_HMAC_SECRET=auto
STARMC_VLA_WEBHOOK_SECRET=auto
STARMC_PLUGIN_REFRESH_SECRET=auto
STARMC_DEV_ADMIN_SECRET=auto
STARMC_OAUTH_STATE_SECRET=auto

# 数据库（可选，空则使用内置 JSON 存储）
# STARMC_DATABASE_URL=

# SMTP（production 必填；DirectMail 推荐使用独立发信子域）
# STARMC_SMTP_HOST=smtpdm.aliyun.com
# STARMC_SMTP_PORT=465
# STARMC_SMTP_SECURE=true
# STARMC_SMTP_USER=noreply@notify.star-mc.top
# STARMC_SMTP_PASSWORD=请仅在本地私密覆盖或服务器环境中设置
# STARMC_SMTP_FROM_EMAIL=noreply@notify.star-mc.top
# STARMC_SMTP_FROM_NAME=StarMC

# 功能开关（详见 docs/FEATURE_FLAGS.md）
STARMC_REVIEW_ENTRY_ENABLED=false
STARMC_INVITE_CODES_REQUIRED=false
STARMC_INVITE_CODES=
STARMC_REQUIRE_TOTP_FOR_MC_LINK=false
STARMC_MC_GAME_PASSWORD_RESET_ENABLED=true
STARMC_MOJANG_SKIN_SYNC_ENABLED=true
STARMC_TELEMETRY_ENABLED=true
STARMC_SKIN_BRIDGE_PUBLIC_PROFILE=true
STARMC_VLA_NOTIFY_ON_SKIN_CHANGE=true
STARMC_GEO_BLOCKED_COUNTRIES=
